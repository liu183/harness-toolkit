{
  "//": "settings.example.json —— 三档权限示例（Claude Code 格式）。复制为 settings.json 后按项目调整。",
  "//三档原则": "allow = 常用安全操作 · ask = 有副作用的操作 · deny = 不可逆/涉密操作",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Edit(src/**)",
      "Read(**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(.env*)",
      "Edit(**/migrations/**)"
    ]
  }
}
